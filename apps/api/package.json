{
  "name": "@api-gateway/api",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "command": "webpack-cli build",
          "args": [
            "--node-env=production"
          ],
          "cwd": "apps/api"
        },
        "configurations": {
          "development": {
            "args": [
              "--node-env=development"
            ]
          }
        }
      },
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "outputs": [
          "{workspaceRoot}/apps/api/dist/package.json",
          "{workspaceRoot}/apps/api/dist/package-lock.json"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/api/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "@api-gateway/api:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "@api-gateway/api:build:development"
          },
          "production": {
            "buildTarget": "@api-gateway/api:build:production"
          }
        }
      },
      "test": {
        "options": {
          "passWithNoTests": true
        }
      },
      "docker:build": {
        "dependsOn": [
          "build",
          "prune"
        ]
      },
      "metrics-container-smoke": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "commands": [
            "eslint tools/metrics-container-smoke.mjs",
            "node tools/metrics-container-smoke.mjs"
          ],
          "parallel": false
        }
      },
      "grpc-container-smoke": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "commands": [
            "eslint tools/grpc-container-smoke.mjs",
            "node tools/grpc-container-smoke.mjs"
          ],
          "parallel": false
        }
      }
    }
  },
  "dependencies": {
    "@api-gateway/shared-types": "^0.0.1",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/mapped-types": "*",
    "@nestjs/platform-express": "^11.0.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/core": "2.11.0",
    "@opentelemetry/sdk-trace": "2.11.0",
    "graphql": "17.0.2",
    "http-proxy-middleware": "^3.0.3",
    "ioredis": "^5.4.1",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "prom-client": "^15.0.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "tslib": "^2.3.0",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/supertest": "^2.0.16",
    "ioredis-mock": "^8.13.1",
    "nock": "^13.5.4",
    "supertest": "^6.3.4"
  }
}
