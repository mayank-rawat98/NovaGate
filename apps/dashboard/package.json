{
  "name": "@api-gateway/dashboard",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "name": "dashboard",
    "targets": {
      "build": {
        "executor": "@nx/next:build",
        "outputs": [
          "{options.outputPath}"
        ],
        "defaultConfiguration": "production",
        "options": {
          "outputPath": "dist/apps/dashboard"
        },
        "configurations": {
          "development": {
            "outputPath": "dist/apps/dashboard"
          },
          "production": {
            "outputPath": "dist/apps/dashboard"
          }
        },
        "inputs": [
          "default",
          "^default",
          {
            "env": "NEXT_PUBLIC_ADMIN_API_URL"
          },
          {
            "env": "ADMIN_API_URL"
          }
        ]
      },
      "serve": {
        "executor": "@nx/next:server",
        "defaultConfiguration": "development",
        "continuous": true,
        "options": {
          "buildTarget": "dashboard:build",
          "dev": true
        },
        "configurations": {
          "development": {
            "buildTarget": "dashboard:build:development",
            "dev": true,
            "port": 3003
          },
          "production": {
            "buildTarget": "dashboard:build:production",
            "dev": false,
            "port": 3003
          }
        }
      },
      "lint": {
        "executor": "@nx/eslint:lint",
        "options": {
          "lintFilePatterns": [
            "apps/dashboard/src/**/*.{ts,tsx}",
            "apps/dashboard/specs/**/*.{ts,tsx}",
            "apps/dashboard/*.{ts,js,mjs,cjs}"
          ]
        }
      },
      "test": {
        "executor": "@nx/jest:jest",
        "options": {
          "jestConfig": "apps/dashboard/jest.config.cts",
          "passWithNoTests": true
        }
      },
      "typecheck": {
        "executor": "nx:run-commands",
        "options": {
          "command": "tsc --noEmit",
          "cwd": "apps/dashboard"
        },
        "dependsOn": [
          "^typecheck"
        ]
      },
      "preview": {
        "executor": "nx:run-commands",
        "continuous": true,
        "dependsOn": [
          "build"
        ],
        "options": {
          "command": "node tools/dashboard-preview.mjs"
        }
      },
      "ui-smoke": {
        "executor": "nx:run-commands",
        "cache": false,
        "dependsOn": [
          "preview"
        ],
        "options": {
          "commands": [
            "eslint tools/dashboard-smoke.mjs tools/alerts-dashboard-smoke.mjs tools/export-destinations-dashboard-smoke.mjs",
            "node tools/dashboard-smoke.mjs"
          ],
          "parallel": false
        }
      }
    }
  },
  "dependencies": {
    "@api-gateway/shared-types": "^0.0.1",
    "next": "~16.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.7"
  }
}
