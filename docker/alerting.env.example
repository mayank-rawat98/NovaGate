# Admin API alert delivery. Both encryption settings empty means history-only rules.
# Supply a dedicated key ring through your secret manager. Each key is canonical
# base64 encoding of 32 cryptographically random bytes; retain old read keys during
# rotation. Example shape only: {"key-id":"<base64-key>"}. Do not reuse the JWT key.
ALERT_CHANNEL_KEYS=
ALERT_CHANNEL_ACTIVE_KEY=

# Exact operator-trusted origins only, never tenant-configurable. Default public
# HTTPS/443 egress blocks private/metadata addresses and redirects. For deliberate
# internal receivers list explicit origins, e.g. ["https://alerts.internal:8443"].
# Private TLS receivers still require a valid trusted certificate; TLS is not disabled.
ALERT_HTTP_TRUSTED_ORIGINS=[]

# Existing Mailtr API integration. SMTP_API_KEY is a secret; a missing key disables
# email delivery. API acceptance does not prove final inbox receipt. Alert attempts
# carry stable IDs; receivers/providers must implement deduplication for retries.
SMTP_API_KEY=
SMTP_API_BASE_URL=https://api.mailtr.co
SMTP_FROM=support@novagate.dev

# AlertsModule remains disabled until issue #65 dashboard and packaged acceptance
# are complete. Deploy the admin schema migration before updated control plane/workers.
