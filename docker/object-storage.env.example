# Add chosen values to your deployment environment; this file contains no secrets.
# Activate the bundled RustFS service; external S3 deployments omit this profile.
COMPOSE_PROFILES=object-storage
OBJECT_STORAGE_ENABLED=true
OBJECT_STORAGE_ENDPOINT=http://rustfs:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=novagate-archives
# Root credentials belong only to RustFS. Replace placeholders with unique secrets.
RUSTFS_ACCESS_KEY=replace-with-rustfs-root-access-key
RUSTFS_SECRET_KEY=replace-with-a-unique-long-rustfs-root-secret
# Use a service account limited to the archive bucket in production.
OBJECT_STORAGE_ACCESS_KEY=replace-with-archive-service-access-key
OBJECT_STORAGE_SECRET_KEY=replace-with-archive-service-secret-at-least-16-characters
# Pre-create the private bucket, or enable once with a provisioning identity.
OBJECT_STORAGE_CREATE_BUCKET=false
LOG_EXPORT_RETENTION_DAYS=7
