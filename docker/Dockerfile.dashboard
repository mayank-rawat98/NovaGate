FROM node:24-alpine AS builder
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
COPY package.json package-lock.json ./
COPY libs/shared-types/package.json ./libs/shared-types/package.json
COPY apps/api/package.json ./apps/api/package.json
COPY apps/admin-api/package.json ./apps/admin-api/package.json
COPY apps/control-plane/package.json ./apps/control-plane/package.json
COPY apps/dashboard/package.json ./apps/dashboard/package.json
ENV NX_DAEMON=false NX_NO_CLOUD=true
RUN --mount=type=cache,target=/root/.npm npm ci --no-audit --no-fund --ignore-scripts
COPY . .
ARG ADMIN_API_URL=http://admin-api:3001
ENV ADMIN_API_URL=$ADMIN_API_URL
RUN npm exec nx build dashboard

FROM node:24-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
COPY --from=builder /app/dist/apps/dashboard/.next/standalone ./
COPY --from=builder /app/dist/apps/dashboard/.next/static ./dist/apps/dashboard/.next/static
COPY --from=builder /app/apps/dashboard/public ./apps/dashboard/public
USER node
EXPOSE 3003
ENV PORT=3003
HEALTHCHECK --interval=30s --timeout=5s \
  CMD wget -qO- http://127.0.0.1:3003/ || exit 1
CMD ["node", "apps/dashboard/server.js"]
