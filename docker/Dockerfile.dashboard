FROM node:22-alpine AS builder
WORKDIR /app
ARG NEXT_PUBLIC_ADMIN_API_URL
ENV NEXT_PUBLIC_ADMIN_API_URL=$NEXT_PUBLIC_ADMIN_API_URL
COPY package.json package-lock.json ./
COPY libs/shared-types/package.json ./libs/shared-types/package.json
RUN npm install
COPY . .
RUN npx nx sync
RUN npx nx build dashboard

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
COPY --from=builder /app/apps/dashboard/.next/standalone/apps/dashboard ./apps/dashboard
COPY --from=builder /app/apps/dashboard/.next/standalone/node_modules ./apps/dashboard/node_modules
COPY --from=builder /app/apps/dashboard/.next/static ./apps/dashboard/.next/static
COPY --from=builder /app/apps/dashboard/public ./public
USER node
EXPOSE 3003
ENV PORT=3003
HEALTHCHECK --interval=30s --timeout=5s \
  CMD wget -qO- http://127.0.0.1:3003/ || exit 1
CMD ["node", "apps/dashboard/server.js"]
