# Replace placeholders using your deployment secret manager.
GATEWAY_API_KEY=replace-with-issued-gateway-key
CONTROL_PLANE_URL=wss://ws.novagate.dev/gateway-ws
REDIS_URL=redis://redis:6379
JWT_SECRET=replace-with-at-least-32-random-characters
PORT=3000
PROXY_TIMEOUT_MS=10000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_UNAUTH_MAX=100
RATE_LIMIT_AUTH_MAX=500
# Empty means no forwarding headers are trusted. List only your reverse proxies.
TRUSTED_PROXY_CIDRS=

# Active upstream probes (per-service interval overrides the default)
HEALTH_DEFAULT_INTERVAL_MS=10000
HEALTH_FAILURE_THRESHOLD=3
HEALTH_RECOVERY_THRESHOLD=2
HEALTH_PROBE_TIMEOUT_MS=3000
HEALTH_PROBE_CONCURRENCY=8

# Native gRPC is opt-in. Prefer TLS; cleartext is for a private proxy network.
GRPC_ENABLED=false
GRPC_ALLOW_INSECURE=false
GRPC_HOST=127.0.0.1
GRPC_PORT=50051
GRPC_TLS_CERT_FILE=
GRPC_TLS_KEY_FILE=
GRPC_MAX_MESSAGE_BYTES=4194304
GRPC_MAX_HEADER_BYTES=16384
GRPC_MAX_CONCURRENT_STREAMS=100
GRPC_MAX_SESSIONS_PER_TARGET=4
GRPC_MAX_ACTIVE_CALLS=256
GRPC_DEADLINE_MS=30000
GRPC_IDLE_TIMEOUT_MS=30000
GRPC_SHUTDOWN_GRACE_MS=5000

# WebSocket upgrades use the HTTP listener and require supportsWebSocket per service.
# Prefer headers; query credentials require explicit opt-in and are stripped upstream.
WS_ALLOW_QUERY_TOKEN=false
WS_HANDSHAKE_TIMEOUT_MS=5000
WS_MAX_CONNECTIONS=256
WS_MAX_HEADER_BYTES=16384
WS_MAX_BUFFERED_HEAD_BYTES=65536
WS_IDLE_TIMEOUT_MS=300000
WS_SHUTDOWN_GRACE_MS=5000

# Remote identity providers require verified HTTPS by default.
# Only opt into HTTP for explicitly trusted private/local providers.
IDENTITY_PROVIDER_ALLOW_INSECURE_HTTP=false
IDENTITY_PROVIDER_TIMEOUT_MS=5000
IDENTITY_PROVIDER_MAX_RESPONSE_BYTES=262144
IDENTITY_PROVIDER_MAX_HEADER_BYTES=16384
IDENTITY_PROVIDER_MAX_TOKEN_BYTES=16384
IDENTITY_PROVIDER_MAX_PENDING_REQUESTS=128
IDENTITY_PROVIDER_MAX_CONCURRENT_FETCHES=16
IDENTITY_PROVIDER_MAX_CACHE_ENTRIES=128
IDENTITY_PROVIDER_MAX_JWKS_KEYS=64
IDENTITY_PROVIDER_JWKS_CACHE_TTL_MS=300000
IDENTITY_PROVIDER_JWKS_REFRESH_COOLDOWN_MS=30000
IDENTITY_PROVIDER_INTROSPECTION_CACHE_TTL_MS=30000
IDENTITY_PROVIDER_OUTBOUND_CACHE_TTL_MS=3600000

# Native HTTPS/WSS and client trust (read-only operator file mounts).
# Set cert + key together; optional client CA requests certificates for mTLS routes.
#HTTP_TLS_CERT_FILE=/tls/server-chain.pem
#HTTP_TLS_KEY_FILE=/tls/server-key.pem
#HTTP_TLS_CLIENT_CA_FILE=/tls/client-ca-bundle.pem
#HTTP_TLS_CRL_FILE=/tls/client-ca.crl.pem
#GRPC_TLS_CLIENT_CA_FILE=/tls/client-ca-bundle.pem
#GRPC_TLS_CRL_FILE=/tls/client-ca.crl.pem
TLS_HANDSHAKE_TIMEOUT_MS=10000
HTTP_TLS_MAX_CONNECTIONS=1024
# Certificate assertions default off. Trusted proxies must verify mTLS and overwrite both cert/status.
# This is independent of TRUSTED_PROXY_CIDRS and never uses X-Forwarded-For.
MTLS_TRUSTED_PROXY_CIDRS=
MTLS_MAX_CERTIFICATE_BYTES=16384
MTLS_MAX_CA_BUNDLE_BYTES=65536
MTLS_MAX_CHAIN_DEPTH=8
MTLS_MAX_IDENTITY_BYTES=4096

# Bounded webhook raw-body preparation; HMAC secrets are configured per route.
HMAC_MAX_BODY_BYTES=1048576
HMAC_BODY_TIMEOUT_MS=5000
HMAC_MAX_PENDING_REQUESTS=32
HMAC_MAX_HEADER_BYTES=4096

# AST guard and shared body capture (the smallest applicable limit wins)
GRAPHQL_MAX_QUERY_BYTES=65536
GRAPHQL_MAX_TOKENS=10000
GRAPHQL_MAX_LEXICAL_DEPTH=128
GRAPHQL_MAX_BODY_BYTES=1048576
GRAPHQL_BODY_TIMEOUT_MS=5000
GRAPHQL_MAX_PENDING_REQUESTS=32
BODY_CAPTURE_MAX_BODY_BYTES=16777216
BODY_CAPTURE_TIMEOUT_MS=5000
BODY_CAPTURE_MAX_PENDING_REQUESTS=64

# Bounded HTTP/2 upstream pool
HTTP2_MAX_TARGETS=64
HTTP2_MAX_SESSIONS=64
HTTP2_MAX_SESSIONS_PER_TARGET=10
HTTP2_MAX_STREAMS_PER_SESSION=100
HTTP2_MAX_ACTIVE_REQUESTS=64
HTTP2_MAX_RESPONSE_BYTES=4194304
HTTP2_MAX_HEADER_BYTES=16384
HTTP2_CONNECT_TIMEOUT_MS=5000
HTTP2_IDLE_TIMEOUT_MS=30000
PROXY_MAX_HANDLER_CACHE_ENTRIES=256

# Per-replica balancing state and active target reservations
LOAD_BALANCER_MAX_SERVICES=1024
LOAD_BALANCER_MAX_TARGETS_PER_SERVICE=256
LOAD_BALANCER_MAX_ACTIVE_RESERVATIONS=4096

# Bounded, parent-aware OpenTelemetry tracing (no request payload attributes)
TRACING_ENABLED=true
TRACING_SAMPLE_RATE=0.1
TRACING_MAX_ACTIVE_SPANS=1024
TRACING_MAX_QUEUED_SPANS=512
TRACING_MAX_QUEUE_BYTES=1048576
TRACING_MAX_BATCH_SPANS=32
TRACING_MAX_BATCH_BYTES=65536
TRACING_FLUSH_INTERVAL_MS=1000
TRACING_MAX_BUFFERED_BYTES=131072

# Best-effort HTTP metrics (fixed histogram percentile estimates)
METRICS_REPORT_INTERVAL_MS=1000
METRICS_REPORT_MAX_BUFFERED_BYTES=65536
