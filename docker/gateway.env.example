# Replace placeholders using your deployment secret manager.
GATEWAY_API_KEY=replace-with-issued-gateway-key
CONTROL_PLANE_URL=wss://ws.novagate.dev/gateway-ws
REDIS_URL=redis://redis:6379
JWT_SECRET=replace-with-at-least-32-random-characters
PORT=3000
PROXY_TIMEOUT_MS=10000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_UNAUTH_MAX=100
RATE_LIMIT_AUTH_MAX=500
# Empty means no forwarding headers are trusted. List only your reverse proxies.
TRUSTED_PROXY_CIDRS=

# Active upstream probes (per-service interval overrides the default)
HEALTH_DEFAULT_INTERVAL_MS=10000
HEALTH_FAILURE_THRESHOLD=3
HEALTH_RECOVERY_THRESHOLD=2
HEALTH_PROBE_TIMEOUT_MS=3000
HEALTH_PROBE_CONCURRENCY=8

# Native gRPC is opt-in. Prefer TLS; cleartext is for a private proxy network.
GRPC_ENABLED=false
GRPC_ALLOW_INSECURE=false
GRPC_HOST=127.0.0.1
GRPC_PORT=50051
GRPC_TLS_CERT_FILE=
GRPC_TLS_KEY_FILE=
GRPC_MAX_MESSAGE_BYTES=4194304
GRPC_MAX_HEADER_BYTES=16384
GRPC_MAX_CONCURRENT_STREAMS=100
GRPC_MAX_SESSIONS_PER_TARGET=4
GRPC_MAX_ACTIVE_CALLS=256
GRPC_DEADLINE_MS=30000
GRPC_IDLE_TIMEOUT_MS=30000
GRPC_SHUTDOWN_GRACE_MS=5000
